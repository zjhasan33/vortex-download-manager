{
  "manifest_version": 3,
  "name": "Vortex Companion",
  "version": "1.3.1",
  "description": "Capture downloads and grab videos from any site — works with the Vortex download manager (like IDM's extension).",
  "minimum_chrome_version": "111",
  "permissions": [
    "alarms",
    "webRequest",
    "contextMenus",
    "notifications",
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17190/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}