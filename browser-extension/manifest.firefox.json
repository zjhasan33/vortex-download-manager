{
  "manifest_version": 3,
  "name": "Vortex Companion",
  "version": "1.3.0",
  "description": "Capture downloads and grab videos from any site — works with the Vortex download manager (like IDM's extension).",
  "permissions": [
    "alarms",
    "webRequest",
    "contextMenus",
    "notifications",
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "ws://127.0.0.1:17190/*",
    "http://127.0.0.1:17190/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vortex-companion@vortex.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}